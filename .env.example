# ---- Database (Neon) ----
# Copy the connection string from the Neon dashboard. "postgresql://" is auto-converted
# to the psycopg3 driver. Keep sslmode=require for Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
WEBHOOK_SECRET=change-me-webhook-secret
# Comma-separated emails that become ADMIN on signup (can manage centres/tests)
ADMIN_EMAILS=admin@example.com

# ---- Redis (cache, rate limiting, Celery). Leave empty to fall back to in-memory. ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ---- Behaviour ----
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
CACHE_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
PAYMENT_RATE_LIMIT_PER_MINUTE=20
PAYMENT_SUCCESS_RATE=0.8
ALLOW_SIMULATED_OUTCOME=true
WEBHOOK_MAX_ATTEMPTS=5
PENDING_BOOKING_TTL_MINUTES=30
LOG_LEVEL=INFO
